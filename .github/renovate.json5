{
  // Renovate via the Mend-hosted GitHub App (free for public repos): zero cluster
  // footprint, zero CI minutes, no credentials in this repo. Enable once at
  // https://github.com/apps/renovate for Blacklotus89898/Homelab and PRs appear
  // on the weekly schedule below. Merges stay manual (git-only rule); ArgoCD
  // applies whatever lands on main.
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "assignees": ["Blacklotus89898"],
  // Retired apps (ADR 0010) — no bump PRs for definitions nothing deploys;
  // bump pins deliberately when reactivating (docs/runbooks/reactivate-*.md)
  // (setting ignorePaths replaces the preset's list, so node_modules is restated)
  "ignorePaths": ["archive/**", "**/node_modules/**"],
  "schedule": ["before 5am on Monday"],
  // First run backlogs hard with this many manifests — trickle the PRs
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "labels": ["renovate"],
  "packageRules": [
    {
      // petal is pinned to Petal commit-sha tags, bumped by hand after a Petal
      // CI build — sha tags have no order Renovate can compare, so never PR it
      "matchFileNames": ["services/petal/**"],
      "enabled": false
    },
    {
      // majors (k8s API surface, chart breaking changes) deserve human eyes
      "matchUpdateTypes": ["major"],
      "addLabels": ["major"]
    }
  ]
}
